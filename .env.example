# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/knowledgebase?retryWrites=true&w=majority

# Pinecone vector database
# Index must be created with integrated embedding model: pinecone-sparse-english-v0
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=knowledgebase-entries

# Anthropic Claude API key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Authentication: clang-auth (production: https://auth.clintonlangosch.com, slug kb)
# Local dev uses a local clang-auth and the localtest.me domain so the cookie is
# shared: open http://kb.localtest.me:3003 (not localhost).
# See docs/clang-auth-migration.md.
AUTH_BASE_URL=http://auth.localtest.me:4000
AUTH_APP_SLUG=kb

# AWS S3 for image storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=app-knowledgebase-assets
# Public URL is computed as: https://{bucket}.s3.{region}.amazonaws.com/{key}
